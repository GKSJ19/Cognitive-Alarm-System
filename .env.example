# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/alarm_app_db
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firebase (Google Sign-In) — leave both blank to disable this feature entirely.
# Local dev: use FIREBASE_CREDENTIALS_PATH (path to the downloaded JSON file).
# Cloud deployment (Railway/Render): use FIREBASE_CREDENTIALS_JSON instead —
# paste the ENTIRE file contents as one line. Only set ONE of these two.
# NEVER commit the actual file, paste its contents in chat, or commit this
# value anywhere — treat it like a master password.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Account lockout (Milestone 3)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Password reset (Milestone 3)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
