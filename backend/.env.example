# FastAPI Settings
PROJECT_NAME="ICAP Backend"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY="super-secret-key-for-development-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Databases
# SQLite is used for initial local dev, PostgreSQL is recommended for production
DATABASE_URL="sqlite+aiosqlite:///./icap.db"
# PostgreSQL default format: postgresql+asyncpg://user:password@localhost:5432/icap
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/icap"

# MongoDB for challenges & logs
MONGO_URI="mongodb://localhost:27017"

# Social Authentication
GOOGLE_CLIENT_ID="your-google-client-id-here"
APPLE_CLIENT_ID="your-apple-client-id-here"

# SMTP (Email Verification & Forgot Password)
# If empty, verification emails will be printed directly to the console/terminal
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@icap.com"
